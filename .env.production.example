# ==============================================================================
# PRODUCTION ENVIRONMENT CONFIGURATION (PAPER-ONLY)
# ==============================================================================
# Purpose: Protected production deployment configuration.
# Broker Target: An operator-supplied Alpaca paper account, only when integration is enabled.
# Port / Networking: Runs on Port 80 (via compose.production.yml).
# ==============================================================================

# Application
ENVIRONMENT=production

# Production never uses the staging historical replay. ShadowFund is an
# isolated, non-executing observer for the approved production paper workflow.
BACKTEST_SIMULATION_ENABLED=false
BACKTEST_OUTPUT_DIR=/app/backtest-runs
SHADOWFUND_ENABLED=true
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=postgresql+asyncpg://shadowfund:shadowfund@postgres:5432/shadowfund
REDIS_URL=redis://redis:6379/0
CORS_ALLOWED_ORIGINS=["http://localhost"]

# Alpaca paper credentials (replace with protected operator-managed values; never commit)
ALPACA_API_KEY=your_official_hackathon_paper_key
ALPACA_SECRET_KEY=your_official_hackathon_paper_secret
ALPACA_PAPER=true
ALPACA_LIVE_TRADE=false
ALPACA_CLI_PATH=alpaca
ALPACA_REQUEST_TIMEOUT_SECONDS=30

# Execution control
EXECUTION_ENABLED=false
ACTIVE_RULESET_VERSION=1.0.0
EXECUTION_KILL_SWITCH=true

# Autonomous paper-trading schedule (server-side worker; disabled by default).
# Dates must stay within the BA window.
AUTONOMOUS_TRADING_ENABLED=false
AUTONOMOUS_TRADING_START_AT=2026-08-31T13:30:00Z
AUTONOMOUS_TRADING_END_AT=2026-09-03T20:00:00Z

# Optional server-side historical IV provider. Never expose this to the UI.
IV_RANK_HISTORY_URL=
IV_RANK_HISTORY_API_KEY=
IV_RANK_LOOKBACK_DAYS=252
IV_RANK_MIN_OBSERVATIONS=20

# AI / LLM Configuration (supports featherless, anthropic, gemini, ollama, deepseek, openai)
LLM_PROVIDER=featherless
LLM_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Seeded Authentication for Production (Set strong secrets for official judges & operators)
AUTH_EMAIL=operator@prism.local
AUTH_PASSWORD=replace-with-production-password
AUTH_SECRET_KEY=replace-with-production-session-secret-at-least-32-characters
AUTH_SESSION_EXPIRE_HOURS=24

# Server-only backend endpoint for Production
API_INTERNAL_URL=http://backend:8000/api/v1
