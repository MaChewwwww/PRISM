# ==============================================================================
# PRODUCTION ENVIRONMENT CONFIGURATION (OFFICIAL HACKATHON ACCOUNT)
# ==============================================================================
# Purpose: Authoritative flagship competition trading & judging review.
# Broker Target: Official Hackathon-provided Alpaca Paper Account ($100,000 baseline).
# Port / Networking: Runs on Port 80 (via compose.production.yml).
# ==============================================================================

# Application
ENVIRONMENT=production
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=postgresql+asyncpg://shadowfund:shadowfund@postgres:5432/shadowfund
REDIS_URL=redis://redis:6379/0

# Official Hackathon Alpaca Paper Account ($100,000.00 Starting Balance)
ALPACA_API_KEY=your_official_hackathon_paper_key
ALPACA_SECRET_KEY=your_official_hackathon_paper_secret
ALPACA_PAPER=true
ALPACA_LIVE_TRADE=false
ALPACA_CLI_PATH=alpaca
ALPACA_REQUEST_TIMEOUT_SECONDS=30

# Execution control
EXECUTION_ENABLED=false
ACTIVE_RULESET_VERSION=

# AI / LLM Configuration (supports featherless, anthropic, gemini, ollama, deepseek, openai)
LLM_PROVIDER=featherless
LLM_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Seeded Authentication for Production (Set strong secrets for official judges & operators)
AUTH_EMAIL=operator@shadowfund.local
AUTH_PASSWORD=your_production_seeded_password
AUTH_SECRET_KEY=your_production_hmac_secret_key
AUTH_SESSION_EXPIRE_HOURS=24

# Browser API endpoint for Production
NEXT_PUBLIC_API_BASE_URL=http://localhost/api/v1
