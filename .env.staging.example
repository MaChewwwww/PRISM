# ==============================================================================
# STAGING ENVIRONMENT CONFIGURATION (DUMMY / PERSONAL TEST ACCOUNT)
# ==============================================================================
# Purpose: Pre-release validation & test simulations.
# Broker Target: Personal / throwaway Alpaca Paper Account (preserves competition balance).
# Port / Networking: Runs on Port 8080 (via compose.staging.yml).
# ==============================================================================

# Application
ENVIRONMENT=staging
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=postgresql+asyncpg://shadowfund:shadowfund@localhost:5432/shadowfund_staging
REDIS_URL=redis://localhost:6379/1

# Personal / Test Dummy Alpaca Paper Account (Zero impact on competition funds)
ALPACA_API_KEY=your_personal_dummy_paper_key
ALPACA_SECRET_KEY=your_personal_dummy_paper_secret
ALPACA_PAPER=true
ALPACA_LIVE_TRADE=false
ALPACA_CLI_PATH=alpaca
ALPACA_REQUEST_TIMEOUT_SECONDS=30

# Execution control (Enable only for test trade simulations in staging)
EXECUTION_ENABLED=false
ACTIVE_RULESET_VERSION=

# AI / LLM Configuration (supports featherless, anthropic, gemini, ollama, deepseek, openai)
LLM_PROVIDER=featherless
LLM_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Seeded Authentication for Staging
AUTH_EMAIL=staging-operator@shadowfund.local
AUTH_PASSWORD=shadowfund-staging-2026!
AUTH_SECRET_KEY=governed-shadowfund-staging-secret-key-change-in-staging
AUTH_SESSION_EXPIRE_HOURS=24

# Browser API endpoint for Staging
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
STAGING_HTTP_PORT=8080
