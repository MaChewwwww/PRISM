# ==============================================================================
# STAGING ENVIRONMENT CONFIGURATION (PAPER-ONLY)
# ==============================================================================
# Purpose: Pre-release validation & test simulations.
# Broker Target: An operator-supplied staging Alpaca paper account, only when integration is enabled.
# Port / Networking: Runs on Port 3005 (via compose.staging.yml).
# ==============================================================================

# Application
ENVIRONMENT=staging
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=postgresql+asyncpg://shadowfund:shadowfund@localhost:5432/shadowfund_staging
REDIS_URL=redis://localhost:6379/1
CORS_ALLOWED_ORIGINS=["http://localhost:3005"]

# Alpaca paper credentials (replace with protected staging values; never commit)
ALPACA_API_KEY=your_personal_dummy_paper_key
ALPACA_SECRET_KEY=your_personal_dummy_paper_secret
ALPACA_PAPER=true
ALPACA_LIVE_TRADE=false
ALPACA_CLI_PATH=alpaca
ALPACA_REQUEST_TIMEOUT_SECONDS=30

# Execution control (remains disabled in this skeleton)
EXECUTION_ENABLED=false
ACTIVE_RULESET_VERSION=

# AI / LLM Configuration (supports featherless, anthropic, gemini, ollama, deepseek, openai)
LLM_PROVIDER=featherless
LLM_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Seeded Authentication for Staging
AUTH_EMAIL=staging-operator@prism.local
AUTH_PASSWORD=replace-with-staging-password
AUTH_SECRET_KEY=replace-with-staging-session-secret-at-least-32-characters
AUTH_SESSION_EXPIRE_HOURS=24

# Server-only backend endpoint for Staging
API_INTERNAL_URL=http://backend:8000/api/v1
STAGING_HTTP_PORT=3005
