# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=postgresql+asyncpg://shadowfund:shadowfund@localhost:5432/shadowfund
REDIS_URL=redis://localhost:6379/0
CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:3005"]

# Alpaca paper trading only. Never put real credentials in this file.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true
ALPACA_LIVE_TRADE=false
ALPACA_CLI_PATH=alpaca
ALPACA_REQUEST_TIMEOUT_SECONDS=30

# Execution is paper-only and remains fail-closed until both controls and
# server readiness gates are satisfied.
EXECUTION_ENABLED=false
ACTIVE_RULESET_VERSION=1.0.0
EXECUTION_KILL_SWITCH=true


# Autonomous paper-trading schedule. Keep disabled by default. When enabled,
# execution must also be enabled and the same worker runs in staging and
# production using each environment's separate paper credentials. In
# production, the UTC window must remain inside the BA-authorized hackathon
# window. Staging validation uses the separate historical backtest command.
AUTONOMOUS_TRADING_ENABLED=false
AUTONOMOUS_TRADING_START_AT=2026-08-31T13:30:00Z
AUTONOMOUS_TRADING_END_AT=2026-09-03T20:00:00Z

# Historical IV rank (server-side provider optional; durable observed-chain
# history is used when the provider is absent and fails closed until populated).
IV_RANK_HISTORY_URL=
IV_RANK_HISTORY_API_KEY=
IV_RANK_LOOKBACK_DAYS=252
IV_RANK_MIN_OBSERVATIONS=20

# AI / LLM Configuration (supports featherless, ollama, deepseek, and openai)
LLM_PROVIDER=featherless
LLM_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
# LLM usage records never include prompts or credentials. Configure a current
# provider rate card only if PRISM should calculate an estimated USD cost.
LLM_USAGE_TRACKING_ENABLED=true
LLM_INPUT_PRICE_PER_MILLION_USD=
LLM_OUTPUT_PRICE_PER_MILLION_USD=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Seeded Authentication (protects staging, production, and dev console)
AUTH_EMAIL=operator@prism.local
AUTH_PASSWORD=prism-development-only
AUTH_SECRET_KEY=prism-development-only-session-secret-rotate
AUTH_SESSION_EXPIRE_HOURS=24

# Server-only backend URL for the Next.js application.
API_INTERNAL_URL=http://localhost:8000/api/v1

# Used only by the isolated staging Compose override.
STAGING_HTTP_PORT=3005
