# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=postgresql+asyncpg://shadowfund:shadowfund@localhost:5432/shadowfund
REDIS_URL=redis://localhost:6379/0
CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:3005"]

# Alpaca paper trading only. Never put real credentials in this file.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true
ALPACA_LIVE_TRADE=false
ALPACA_CLI_PATH=alpaca
ALPACA_REQUEST_TIMEOUT_SECONDS=30

# Execution is deliberately unavailable until both controls are configured.
EXECUTION_ENABLED=false
ACTIVE_RULESET_VERSION=

# AI / LLM Configuration (supports featherless, anthropic, gemini, ollama, deepseek, openai)
LLM_PROVIDER=featherless
LLM_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Seeded Authentication (protects staging, production, and dev console)
AUTH_EMAIL=operator@prism.local
AUTH_PASSWORD=prism-development-only
AUTH_SECRET_KEY=prism-development-only-session-secret-rotate
AUTH_SESSION_EXPIRE_HOURS=24

# Server-only backend URL for the Next.js application.
API_INTERNAL_URL=http://localhost:8000/api/v1

# Used only by the isolated staging Compose override.
STAGING_HTTP_PORT=3005
